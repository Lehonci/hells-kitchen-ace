# ==============================================================================
# NOTIFICATION & CONTACT CONFIGURATION (100% Free Forever Tiers)
# ==============================================================================

# 1. Resend (Email Service - 3,000 emails/month free)
# Get your API key at https://resend.com
RESEND_API_KEY=re_123456789_abcdefg
CONTACT_TO_EMAIL=zafiraryani@gmail.com
# Optional: if you verify your custom domain on Resend (e.g. contact@zafiraryani.com)
# RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# 2. Discord Webhook (Instant Notification to your Discord Server - Free)
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# 3. Telegram Bot (Instant Notification to your Telegram Chat - Free)
# Create a bot via @BotFather to get the token, and get your user ID via @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
